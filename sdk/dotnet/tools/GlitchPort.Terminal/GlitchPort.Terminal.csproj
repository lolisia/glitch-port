<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The renderer spawned by the terminal relay. It is published as a native
    AOT executable, so keep the code free of reflection-based serialization:
    only System.Text.Json's JsonDocument API is used.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>glitchport-terminal</AssemblyName>
    <RootNamespace>GlitchPort.Terminal</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GlitchPort.Core\GlitchPort.Core.csproj" />
  </ItemGroup>

</Project>
