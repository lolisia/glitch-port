<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ASP.NET Core integration for the glitch-port .NET SDK.

    The package only references the shared ASP.NET Core framework and the
    dependency-free GlitchPort.Core library. Do not add PackageReference items
    here: everything the integration needs (hosting, logging, configuration)
    is part of Microsoft.AspNetCore.App.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0</Version>
    <AssemblyName>GlitchPort.AspNetCore</AssemblyName>
    <RootNamespace>GlitchPort.AspNetCore</RootNamespace>
    <Description>ASP.NET Core integration for the glitch-port .NET SDK: dependency injection, request exception capture and ILogger forwarding.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlitchPort.Core\GlitchPort.Core.csproj" />
  </ItemGroup>

</Project>
