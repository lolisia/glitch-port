<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end sample used by the repository verification flow.

    It must stay dependency-free beyond GlitchPort.Core: the point of the sample
    is to show that capturing a message only needs the SDK core. The terminal
    renderer is referenced with ReferenceOutputAssembly="false" so it is only
    built (and then copied next to the sample), never linked against.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HelloClient</AssemblyName>
    <RootNamespace>GlitchPort.HelloClient</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GlitchPort.Core\GlitchPort.Core.csproj" />
    <ProjectReference Include="..\..\tools\GlitchPort.Terminal\GlitchPort.Terminal.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The sample's tests live in a nested project directory. The default SDK globs
    compile everything below this folder, so exclude the test project tree from
    the sample itself.
  -->
  <ItemGroup>
    <Compile Remove="HelloClient.Tests\**" />
    <Content Remove="HelloClient.Tests\**" />
    <EmbeddedResource Remove="HelloClient.Tests\**" />
    <None Remove="HelloClient.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HelloClient.Tests" />
  </ItemGroup>

  <!--
    Ship the terminal renderer next to HelloClient so the "terminal:" relay can
    find it through AppContext.BaseDirectory without a separate install step.

    The item glob is evaluated when the target runs, i.e. after the project
    reference above has built glitchport-terminal in the same configuration.
  -->
  <Target Name="CopyTerminalTool" AfterTargets="Build">
    <ItemGroup>
      <TerminalToolFiles Include="..\..\tools\GlitchPort.Terminal\bin\$(Configuration)\net10.0\glitchport-terminal*" />
    </ItemGroup>
    <Copy SourceFiles="@(TerminalToolFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
