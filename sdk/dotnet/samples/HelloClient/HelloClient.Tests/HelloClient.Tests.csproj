<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the hello sample. They live next to the sample so the sample keeps
    a single, dependency-free production project.

    The terminal renderer is built and copied into the test output directory so
    the terminal relay tests exercise a real child process, exactly like a
    HelloClient build does.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HelloClient.Tests</AssemblyName>
    <RootNamespace>GlitchPort.HelloClient.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelloClient.csproj" />
    <ProjectReference Include="..\..\..\tools\GlitchPort.Terminal\GlitchPort.Terminal.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Put glitchport-terminal next to the test assembly. The glob runs after the
    build, when the referenced tool project has produced its output.
  -->
  <Target Name="CopyTerminalToolForTests" AfterTargets="Build">
    <ItemGroup>
      <TerminalToolFiles Include="..\..\..\tools\GlitchPort.Terminal\bin\$(Configuration)\net10.0\glitchport-terminal*" />
    </ItemGroup>
    <Copy SourceFiles="@(TerminalToolFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
