<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>GlitchPort.Tests</RootNamespace>

    <!-- Filled by the ProjectReference build of the fake terminal child. -->
    <TestTerminalChildOutputDirectory>$(MSBuildThisFileDirectory)..\GlitchPort.TestTerminalChild\bin\$(Configuration)\net10.0\</TestTerminalChildOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="JsonSchema.Net" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The protocol schema is the single source of truth shared by every SDK and
      the collector; the serializer tests validate the emitted events against it.
    -->
    <None
      Include="..\..\..\protocol\event.v1.schema.json"
      Link="protocol\event.v1.schema.json"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GlitchPort.Core\GlitchPort.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The terminal relay tests start a real child process. The project is built
      first but not referenced as an assembly; the target below copies its
      output (apphost, dll, runtimeconfig, deps) next to the test assembly so
      TerminalRelayOptions.ExecutablePath can point at a platform executable.
    -->
    <ProjectReference
      Include="..\GlitchPort.TestTerminalChild\GlitchPort.TestTerminalChild.csproj"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyTestTerminalChild" AfterTargets="Build">
    <ItemGroup>
      <TestTerminalChildFiles Include="$(TestTerminalChildOutputDirectory)**\*" />
    </ItemGroup>

    <Warning
      Condition="'@(TestTerminalChildFiles)' == ''"
      Text="The fake terminal child was not built; terminal relay tests will fail." />

    <Copy
      SourceFiles="@(TestTerminalChildFiles)"
      DestinationFolder="$(OutDir)test-terminal-child\%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
