<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>GlitchPort.AspNetCore.Tests</RootNamespace>
    <AssemblyName>GlitchPort.AspNetCore.Tests</AssemblyName>
    <!-- The test assembly defines the WebApplicationFactory entry point itself. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <!--
      WebApplicationFactory normally finds the content root through a solution
      file. This repository has no solution, and the entry point lives in this
      test assembly, so the content root is declared below instead.
    -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GlitchPort.AspNetCore\GlitchPort.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="Microsoft.AspNetCore.Mvc.Testing.WebApplicationFactoryContentRootAttribute">
      <!-- Key = typeof(Program).Assembly.FullName for the entry point. -->
      <_Parameter1>$(AssemblyName), Version=$(AssemblyVersion), Culture=neutral, PublicKeyToken=null</_Parameter1>
      <!-- Relative to AppContext.BaseDirectory (bin/$(Configuration)/net10.0). -->
      <_Parameter2>../../../</_Parameter2>
      <_Parameter3>GlitchPort.AspNetCore.Tests.csproj</_Parameter3>
      <_Parameter4>0</_Parameter4>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The Mvc.Testing targets generate MvcTestingAppManifest.json for referenced
    web projects. Our entry point is this test assembly, so add its key too; "~"
    maps to AppContext.BaseDirectory.
  -->
  <Target Name="_AddTestAssemblyContentRoot" BeforeTargets="_AddContentRootForProjectReferences">
    <ItemGroup>
      <_ManifestProjects Include="$(AssemblyName), Version=$(AssemblyVersion), Culture=neutral, PublicKeyToken=null">
        <ContentRoot>~</ContentRoot>
      </_ManifestProjects>
    </ItemGroup>
  </Target>

</Project>
