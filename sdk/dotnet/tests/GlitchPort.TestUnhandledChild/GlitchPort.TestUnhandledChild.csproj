<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A test-owned executable that crashes with an unhandled exception so the
    Core tests can prove UnhandledExceptionIntegration captures and flushes a
    Fatal event through a real file relay. It references GlitchPort.Core and is
    copied next to the test assembly, like GlitchPort.TestTerminalChild.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GlitchPort.TestUnhandledChild</AssemblyName>
    <RootNamespace>GlitchPort.TestUnhandledChild</RootNamespace>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GlitchPort.Core\GlitchPort.Core.csproj" />
  </ItemGroup>

</Project>
