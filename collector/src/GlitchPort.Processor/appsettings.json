{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Processor": {
    "Alerts": {
      "Enabled": true,
      "EvaluateIntervalSeconds": 60,
      "DispatchIntervalSeconds": 5,
      "MaxAttempts": 5,
      "HttpTimeoutSeconds": 10,
      "DashboardBaseUrl": "",
      "RetentionDays": 30
    }
  }
}
