# Local dashboard image for the `full` Docker Compose profile.
#
# The Vite build runs inside the image so the static bundle is self-contained.
# Both arguments are development values: the dashboard talks to processor-1 on
# the host (port 5091) and authenticates with the development admin token.
FROM node:22-alpine AS build
WORKDIR /app
COPY dashboard/package*.json ./
RUN npm ci
COPY dashboard/ ./
ARG VITE_API_BASE=http://localhost:5091
ARG VITE_ADMIN_TOKEN=dev-admin-token
ENV VITE_API_BASE=$VITE_API_BASE \
    VITE_ADMIN_TOKEN=$VITE_ADMIN_TOKEN
RUN npm run build

FROM nginx:stable-alpine
COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY deploy/local/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
