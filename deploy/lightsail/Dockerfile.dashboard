FROM node:22-alpine AS build
WORKDIR /app
COPY dashboard/package*.json ./
RUN npm ci
COPY dashboard/ ./
ENV VITE_API_BASE="" VITE_ADMIN_TOKEN=""
RUN npm run build

FROM nginx:stable-alpine
COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY deploy/lightsail/nginx.conf.template /etc/nginx/templates/default.conf.template
ENV NGINX_ENVSUBST_FILTER="PROCESSOR_ADMIN_TOKEN|GLITCHPORT_HOST"
